# ==============================================================================
# NEXUS GAMING PORTAL & FORUM - ENVIRONMENT CONFIGURATION
# Kopirajte ovaj fajl u svoj lokalni .env fajl:
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & APPLICATION SETTINGS
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV="development"
# Javni URL aplikacije (koristi se za linkove u mejlovima, npr. reset lozinke).
# U produkciji OBAVEZNO postaviti na pravi domen, npr. https://nexusgaming.gg
APP_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
# Opciono: dodatni dozvoljeni CORS origin-i (npr. staging), odvojeni zapetom.
EXTRA_ALLOWED_ORIGINS=""
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL & AUTHENTICATION
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
SUPABASE_KEY="your-supabase-service-role-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ------------------------------------------------------------------------------
# 3. JWT AUTHENTICATION SECRETS (Server-side) — OBAVEZNO
# ------------------------------------------------------------------------------
# Generišite jake slučajne vrednosti (najmanje 32 karaktera), npr:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# U produkciji server ODBIJA start ako ove vrednosti nisu postavljene.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_RESET_SECRET=""

# ------------------------------------------------------------------------------
# 4. STORAGE & PRESIGNED URLS SECURITY (Server-side) — OBAVEZNO
# ------------------------------------------------------------------------------
STORAGE_HMAC_SECRET=""
STORAGE_UPLOAD_SECRET=""

# ------------------------------------------------------------------------------
# 5. ADMINISTRATORS & CREDENTIALS (Server-side)
# ------------------------------------------------------------------------------
# Lista email adresa koje imaju pun administratorski pristup sistemu (odvojeno zapetom).
# Ostavite prazno ako ne koristite env baziran admin fallback.
ADMIN_EMAILS=""

# Lozinka za administratorske naloge. Ostavite prazno da se admin fallback ne kreira.
# Preporuka: koristite jake lozinke ili ADMIN_PASSWORD_HASH.
ADMIN_PASSWORD=""

# Opciono: Ako već imate generisan bcrypt hash lozinke, navedite ga ovde (preporučeno):
ADMIN_PASSWORD_HASH=""

# ------------------------------------------------------------------------------
# 5b. FRONTEND ADMIN EMAILS (build-time, javno)
# ------------------------------------------------------------------------------
# Ista lista kao ADMIN_EMAILS, ali dostupna frontend-u za prikaz admin UI-a.
# NAPOMENA: ovo je samo UI hint; stvarna autorizacija se vrši na serveru/DB-u.
VITE_ADMIN_EMAILS=""

# ------------------------------------------------------------------------------
# 6. EMAIL (TRANSACTIONAL) — RESET LOZINKE
# ------------------------------------------------------------------------------
# Resend API ključ (https://resend.com). Ako nije postavljen, mejlovi se u razvoju
# samo loguju u konzolu (link za reset i dalje radi), a u produkciji se ne šalju.
RESEND_API_KEY=""

# "From" adresa za transakcione mejlove. Mora biti verifikovan domen u Resend-u.
EMAIL_FROM="Nexus GG <no-reply@nexusgaming.gg>"
